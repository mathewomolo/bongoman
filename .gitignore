# Dependencies - rebuilt from package.json, never committed
node_modules/

# Build output - regenerated by `npm run build`
dist/
dist-ssr/

# Local env files - may hold keys or secrets
.env
.env.local
.env.*.local

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Vite cache
.vite/